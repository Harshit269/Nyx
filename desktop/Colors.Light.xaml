<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light: white tiles on a light grey floor. Red is reserved for live and urgent things. -->
    <SolidColorBrush x:Key="Canvas"      Color="#ECECEC"/>
    <SolidColorBrush x:Key="Rail"        Color="#E4E4E4"/>
    <SolidColorBrush x:Key="Tile"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Tile2"       Color="#F4F4F4"/>
    <SolidColorBrush x:Key="Hover"       Color="#EFEFEF"/>
    <SolidColorBrush x:Key="Line"        Color="#E3E3E3"/>
    <SolidColorBrush x:Key="LineStrong"  Color="#CDCDCD"/>
    <SolidColorBrush x:Key="Ink"         Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Ink2"        Color="#555555"/>
    <SolidColorBrush x:Key="Ink3"        Color="#6E6E6E"/>
    <SolidColorBrush x:Key="OnInk"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Red"         Color="#D71921"/>
    <SolidColorBrush x:Key="RedSoft"     Color="#FBE4E5"/>
    <SolidColorBrush x:Key="OnRed"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Charge"      Color="#1F8A4C"/>
    <SolidColorBrush x:Key="Online"      Color="#1F8A4C"/>
    <SolidColorBrush x:Key="Saver"       Color="#A36A00"/>
    <SolidColorBrush x:Key="DotOff"      Color="#DEDEDE"/>
    <SolidColorBrush x:Key="Toast"       Color="#0A0A0A"/>
    <SolidColorBrush x:Key="ToastInk"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToastInk2"   Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Shade"       Color="#000000"/>
    <SolidColorBrush x:Key="Clear"       Color="#00FFFFFF"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.07</sys:Double>
</ResourceDictionary>
