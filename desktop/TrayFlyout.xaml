<Window x:Class="PhoneBridge.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhoneBridge"
        Title="Nyx" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Foreground="{DynamicResource Ink}" FontFamily="{StaticResource UiFont}" FontSize="13"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- recent rows: flat, with a soft highlight under the pointer -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Tile2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- a small panel by the tray: the phone, what it's doing, shortcuts and recent people -->
    <Border x:Name="Card" Margin="12" CornerRadius="22" Background="{DynamicResource Tile}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1" RenderTransformOrigin="0.5,1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Direction="270"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <StackPanel Margin="20,22,20,14">

            <!-- the phone -->
            <Border Width="56" Height="112" CornerRadius="11" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1.5"
                    Padding="2" HorizontalAlignment="Center" Background="{DynamicResource Tile2}">
                <Border x:Name="Screen" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource Tile2}">
                    <Image x:Name="Wall" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Border>
            <TextBlock x:Name="PhoneLabel" Text="No phone" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel x:Name="Icons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource LineStrong}"/>
                <local:LineIcon x:Name="Bt" Data="{StaticResource IconBluetooth}" Width="14" Height="14" Margin="0,0,10,0"/>
                <local:LineIcon x:Name="Wifi" Data="{StaticResource IconWifi}" Width="14" Height="14" Margin="0,0,10,0"/>
                <TextBlock x:Name="Battery" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="State" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" FontSize="12"/>

            <!-- shortcuts -->
            <UniformGrid Columns="2" Margin="-4,16,-4,0">
                <Button Style="{StaticResource Btn}" Height="44" Margin="4" Tag="14" Click="SendFiles_Click" HorizontalContentAlignment="Left" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LineIcon Data="{StaticResource IconUpload}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Text="Send files" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Height="44" Margin="4" Tag="14" Click="Mirror_Click" HorizontalContentAlignment="Left" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LineIcon Data="{StaticResource IconMonitor}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Text="Mirror" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Height="44" Margin="4" Tag="14" Click="Messages_Click" HorizontalContentAlignment="Left" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LineIcon Data="{StaticResource IconMessage}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Text="Messages" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Height="44" Margin="4" Tag="14" Click="Calls_Click" HorizontalContentAlignment="Left" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LineIcon Data="{StaticResource IconPhone}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock Text="Calls" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Height="44" Margin="4" Tag="14" Click="Notifs_Click" HorizontalContentAlignment="Left" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LineIcon Data="{StaticResource IconBell}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock x:Name="NotifLabel" Text="Notifications" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}" Height="44" Margin="4" Tag="14" Click="Find_Click" HorizontalContentAlignment="Left" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <local:LineIcon Data="{StaticResource IconSmartphone}" Width="15" Height="15" Margin="0,0,10,0"/>
                        <TextBlock x:Name="FindLabel" Text="Find phone" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- recent people -->
            <TextBlock x:Name="RecentCap" Text="Recent" Style="{StaticResource Cap}" Margin="0,18,0,4"/>
            <ItemsControl x:Name="Recent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Row}" Height="52" Padding="6,0" HorizontalContentAlignment="Stretch"
                                Click="Person_Click" Margin="-6,0">
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Tile2}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- footer -->
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="Quit" Style="{StaticResource BtnQuiet}" Height="32" Tag="14" Click="Quit_Click"/>
                <Button Content="Open Nyx" Style="{StaticResource BtnInk}" Height="32" Tag="14" HorizontalAlignment="Left" Padding="16,0" Click="Open_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
