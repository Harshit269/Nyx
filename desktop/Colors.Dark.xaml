<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark: near-black tiles on true black, kind to OLED laptop screens. -->
    <SolidColorBrush x:Key="Canvas"      Color="#000000"/>
    <SolidColorBrush x:Key="Rail"        Color="#000000"/>
    <SolidColorBrush x:Key="Tile"        Color="#101010"/>
    <SolidColorBrush x:Key="Tile2"       Color="#191919"/>
    <SolidColorBrush x:Key="Hover"       Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Line"        Color="#232323"/>
    <SolidColorBrush x:Key="LineStrong"  Color="#353535"/>
    <SolidColorBrush x:Key="Ink"         Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Ink2"        Color="#A6A6A6"/>
    <SolidColorBrush x:Key="Ink3"        Color="#8A8A8A"/>
    <SolidColorBrush x:Key="OnInk"       Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Red"         Color="#EB2F37"/>
    <SolidColorBrush x:Key="RedSoft"     Color="#2A0E10"/>
    <SolidColorBrush x:Key="OnRed"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Charge"      Color="#3DD68C"/>
    <SolidColorBrush x:Key="Online"      Color="#3DD68C"/>
    <SolidColorBrush x:Key="Saver"       Color="#F5C518"/>
    <SolidColorBrush x:Key="DotOff"      Color="#272727"/>
    <SolidColorBrush x:Key="Toast"       Color="#F2F2F2"/>
    <SolidColorBrush x:Key="ToastInk"    Color="#0A0A0A"/>
    <SolidColorBrush x:Key="ToastInk2"   Color="#555555"/>
    <SolidColorBrush x:Key="Shade"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Clear"       Color="#00000000"/>
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.5</sys:Double>
</ResourceDictionary>
