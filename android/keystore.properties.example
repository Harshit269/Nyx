# Copy to keystore.properties (git-ignored) to sign release builds.
# Create a key once with:
#   keytool -genkeypair -v -keystore nyx-release.jks -alias nyx -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks file and these passwords somewhere safe and private. Lose them and you
# can't ship updates under the same app identity.
storeFile=nyx-release.jks
storePassword=CHANGE_ME
keyAlias=nyx
keyPassword=CHANGE_ME
